[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/hamer1818/olang-ext.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "master"]
	remote = origin
	merge = refs/heads/master
	vscode-merge-base = origin/master
[branch "debug/dap-vscode-integration"]
	remote = origin
	merge = refs/heads/debug/dap-vscode-integration
	vscode-merge-base = origin/master
[branch "ci/auto-merge-and-publish"]
	remote = origin
	merge = refs/heads/ci/auto-merge-and-publish
	vscode-merge-base = origin/master
